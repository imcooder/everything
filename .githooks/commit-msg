#!/usr/bin/env node
/**
 * commit-msg: reject commit messages that aren't English-only, mention an AI model/vendor,
 * carry a "Co-Authored-By" trailer, or contain an email outside the allowlist. Same rules CI
 * enforces (scripts/ci/check-commit-messages.mjs) via scripts/lib/commit-lint.mjs — keep both
 * callers in sync.
 */
import { readFileSync } from "fs";
import path from "path";
import { fileURLToPath } from "url";
import { checkMessage } from "../scripts/lib/commit-lint.mjs";

const repoRoot = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "..");
const msgFilePath = process.argv[2];

if (!msgFilePath) {
    console.error("commit-msg hook: no message file path passed by git.");
    process.exit(1);
}

const message = readFileSync(path.resolve(repoRoot, msgFilePath), "utf8");
const problems = checkMessage(message);

if (problems.length > 0) {
    console.error("\ncommit-msg hook rejected this commit message:");
    for (const problem of problems) {
        console.error(`  - ${problem}`);
    }
    console.error("\nRewrite the message (English only, no AI model/vendor mentions, no Co-Authored-By trailer, no non-allowlisted email) and try again.");
    process.exit(1);
}

process.exit(0);
