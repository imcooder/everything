#!/usr/bin/env node
/**
 * Pre-push: run local checks before pushing.
 * Merge to main/master is blocked on GitHub until CI (format, build, test) passes.
 */
import { spawnSync } from "child_process";
import path from "path";
import { fileURLToPath } from "url";

const repoRoot = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "..");

function runNpm(script) {
    const npm = process.platform === "win32" ? "npm.cmd" : "npm";
    const result = spawnSync(npm, ["run", script], { cwd: repoRoot, stdio: "inherit" });
    return result.status === 0;
}

console.log("pre-push: running format:check...");
if (!runNpm("format:check")) {
    console.error("\npre-push failed: fix formatting (npm run format) before pushing.");
    process.exit(1);
}

if (process.platform === "win32") {
    console.log("pre-push: running test (Windows)...");
    if (!runNpm("test")) {
        console.error("\npre-push failed: fix tests before pushing.");
        process.exit(1);
    }
} else {
    console.log("pre-push: skip build/test on non-Windows (CI will verify on GitHub).");
}

console.log("pre-push: OK. Ensure PR checks (format, build, test) are green before merge.");
